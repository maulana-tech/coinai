# ─── Frontend (VITE_*, shipped to the browser) ───
# BNB Smart Chain Testnet (chain 97). Fill after `forge script script/DeployAll.s.sol`.
# Event history (eth_getLogs); contract reads use VITE_CALL_RPC_URL. Defaults in shared/rpc.ts.
VITE_RPC_URL=https://bsc-testnet-rpc.publicnode.com
VITE_CALL_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
VITE_EXPLORER_URL=https://testnet.bscscan.com
# Empty values fall back to the live v2 deployment (shared/deployment.ts). VITE_MOCK=1 runs the in-memory mock.
VITE_MOCK=
VITE_COINAI_ADDRESS=
VITE_TOKEN_ADDRESS=
# Block number of the CoinAI deploy tx (activity history is scanned from here)
VITE_DEPLOY_BLOCK=
# Public address of the agent wallet (the address of AGENT_PRIVATE_KEY below)
VITE_AGENT_ADDRESS=

# ─── AI agent backend (web/api, server-side only — never prefix with VITE_) ───
# CoinAI contract on BSC Testnet (falls back to VITE_COINAI_ADDRESS)
COINAI_ADDRESS=
# Agent reads + transactions. publicnode throttles parallel calls, so the BNB Chain RPC is the default.
BSC_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
# Dedicated agent wallet, holds only tBNB for gas. Users authorize its address via setAgent.
AGENT_PRIVATE_KEY=
# OpenRouter — https://openrouter.ai/keys. Pick any model slug with tool-calling support.
# Comma-separate several keys to rotate when one hits its limit. Users can also add their own
# keys in Settings (BYOK); those are tried first for that wallet.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional comma-separated fallbacks OpenRouter tries if the primary model errors (useful with :free models)
OPENROUTER_FALLBACK_MODELS=
# Testnet yield simulator: how much faster than real time vaults accrue their APY (default 30)
YIELD_SPEEDUP=30
# Optional per-role overrides (e.g. a cheaper model for the reporter)
OPENROUTER_MODEL_STRATEGIST=
OPENROUTER_MODEL_RISK=
OPENROUTER_MODEL_REPORTER=
OPENROUTER_MODEL_CHAT=
# Upstash Redis (Vercel Marketplace → Upstash sets these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Random secrets: openssl rand -base64 32
SESSION_SECRET=
CRON_SECRET=
# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Gmail SMTP: account + App Password (Google Account → Security → App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Public app URL, used for links in reports
APP_URL=
