# Flare Coston2 Testnet configuration
VITE_FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
VITE_FLARE_EXPLORER_URL=https://coston2-explorer.flare.network

# Contract addresses (deploy first, then fill)
VITE_COINAI_ADDRESS=0x588DeC15D915659E8BF36c01e662479916301d3A
VITE_FXRP_ADDRESS=0x0b6A3645c240605887a5532109323A3E12273dc7

# Yield protocol addresses (Flare ecosystem)
VITE_SPARKDEX_ROUTER=
VITE_SPARKDEX_ADAPTER=
VITE_FIRELIGHT_VAULT=
VITE_UPSHIFT_VAULT=

# Output token when routing savings through SparkDexAdapter (e.g. WFLR, USDT0)
VITE_YIELD_TOKEN_OUT=

# Mock mode: set VITE_COINAI_ADDRESS="" to run in-memory mock

# ─── AI agent backend (web/api, server-side only — never prefix with VITE_) ───
# CoinAI contract on BSC Testnet (falls back to VITE_COINAI_ADDRESS)
COINAI_ADDRESS=
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Dedicated agent wallet, holds only tBNB for gas. Users authorize its address via setAgent.
AGENT_PRIVATE_KEY=
# OpenRouter — https://openrouter.ai/keys. Pick any model slug with tool-calling support.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional per-role overrides (e.g. a cheaper model for the reporter)
OPENROUTER_MODEL_STRATEGIST=
OPENROUTER_MODEL_RISK=
OPENROUTER_MODEL_REPORTER=
OPENROUTER_MODEL_CHAT=
# Upstash Redis (Vercel Marketplace → Upstash sets these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Random secrets: openssl rand -base64 32
SESSION_SECRET=
CRON_SECRET=
# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Gmail SMTP: account + App Password (Google Account → Security → App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Public app URL, used for links in reports
APP_URL=
